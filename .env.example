# Sao chep file nay thanh .env roi dien thong tin that
# MongoDB local (mac dinh)
MONGO_URI=mongodb://localhost:27017
DB_NAME=techstore

# Neu dung MongoDB Atlas, thay bang chuoi ket noi cua ban:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# (Tuy chon) Tro ly AI tra loi bang Claude. De trong thi tro ly chay che do
# offline (tra loi theo tu khoa, van doc so lieu that tu MongoDB).
# Lay key tai https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
